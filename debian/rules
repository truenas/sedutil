#!/usr/bin/make -f
export DH_VERBOSE = 1

# Enable hardening
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# Enable automatic debug symbol packages
export DEB_BUILD_OPTIONS = nocheck

%:
	dh $@ --with autoreconf

override_dh_auto_configure:
	dh_autoreconf
	dh_auto_configure

override_dh_auto_install:
	dh_auto_install --destdir=debian/tmp

override_dh_install:
	dh_install

override_dh_strip:
	dh_strip --dbgsym-migration='sedutil-dbg (<< 1.15.1~)'
